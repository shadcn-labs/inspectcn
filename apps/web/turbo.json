{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["$TURBO_EXTENDS$", "registry:build"],
      "env": ["SITE_URL"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "!public/r/**"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "start": {
      "env": ["SITE_URL"]
    }
  }
}
