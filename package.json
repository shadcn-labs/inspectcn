{
  "name": "inspectcn-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:firefox": "turbo run dev:firefox",
    "build": "turbo run build",
    "build:firefox": "turbo run build:firefox",
    "zip": "turbo run zip",
    "zip:firefox": "turbo run zip:firefox",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "registry:build": "turbo run registry:build",
    "check": "turbo run check",
    "fix": "turbo run fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix"
  },
  "devDependencies": {
    "oxfmt": "^0.46.0",
    "oxlint": "^1.86.0",
    "turbo": "^2.10.2",
    "ultracite": "7.6.1"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.2"
}
