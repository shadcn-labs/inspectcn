{
  "name": "inspectcn-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:firefox": "turbo run dev:firefox",
    "build": "turbo run build",
    "build:firefox": "turbo run build:firefox",
    "zip": "turbo run zip",
    "zip:firefox": "turbo run zip:firefox",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "check": "turbo run check",
    "fix": "turbo run fix",
    "format": "turbo run format format:root",
    "format:check": "turbo run format:check format:root:check",
    "format:root": "oxfmt --write . '!apps/**' '!packages/**' '!.build/**' '!.pnpm-store/**'",
    "format:root:check": "oxfmt --check . '!apps/**' '!packages/**' '!.build/**' '!.pnpm-store/**'",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "turbo": "^2.11.7",
    "ultracite": "7.6.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.18.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.28.2"
}
